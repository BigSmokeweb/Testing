# AutoQA — Environment Variables
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to git.
#
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Generate FERNET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Database ──────────────────────────────────────────────────────────────────
# Used by web + worker. Postgres URL in production, or leave blank for SQLite dev.
DATABASE_URL=postgresql://autoqa:CHANGEME@postgres:5432/autoqa

# Postgres container credentials (must match DATABASE_URL above)
POSTGRES_USER=autoqa
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=autoqa

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Random 48-byte URL-safe string for signed sessions
SECRET_KEY=CHANGEME_run_python_secrets_token_urlsafe_48

# Fernet symmetric key for encrypting test credentials at rest
FERNET_KEY=CHANGEME_run_Fernet_generate_key

# ── Application ───────────────────────────────────────────────────────────────
# Set to 1 to enable v1 company dashboard (bypasses login requirement)
LOCAL_MODE=0

# Set to 1 ONLY in dev to bypass domain ownership check (NEVER in production)
SKIP_OWNERSHIP_FOR_DEV=0

# ── Caddy / TLS ───────────────────────────────────────────────────────────────
# Your public domain (A record must point to this server's IP)
DOMAIN=yourdomain.com

# ── Admin Override ────────────────────────────────────────────────────────────
# Comma-separated list of emails that are treated as platform admins.
# Admins may run full crawls on ANY site without domain verification, have no
# daily or quick-check limits, and get higher page caps and longer timeouts.
#
# IMPORTANT: Register your account on the site first, THEN add your email here.
# Never share this variable — anyone listed here gains admin-level test access.
# Leave empty (or omit) to disable admin override entirely.
#
# Example: ADMIN_EMAILS=owner@example.com,backup@example.com
ADMIN_EMAILS=

# Maximum pages an admin crawl may visit (default: 100)
ADMIN_MAX_PAGES=100

# Maximum wall-clock seconds an admin run may take (default: 900 = 15 minutes)
ADMIN_RUN_TIMEOUT_SECONDS=900

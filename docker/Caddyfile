# AutoQA — Caddyfile
# Serves https://{$DOMAIN} and reverse-proxies to the web service.
# Caddy automatically obtains and renews TLS certificates via Let's Encrypt.

{$DOMAIN:localhost} {
    # If serving localhost, Caddy automatically uses local self-signed or HTTP
    # Reverse proxy to the FastAPI web service
    reverse_proxy web:8000

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
        X-Robots-Tag              "noindex, nofollow"
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # Compress responses
    encode gzip

    # Log access (structured) with uri/query filtered for privacy
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json {
            time_format iso8601
        }
    }
}
